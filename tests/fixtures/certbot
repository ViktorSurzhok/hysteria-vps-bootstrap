#!/usr/bin/env python3
"""Offline ACME boundary for the disposable-VM integration test only."""
import os
from pathlib import Path
import subprocess
import sys
args = sys.argv[1:]
assert args[0] == 'certonly', args
name = args[args.index('--cert-name') + 1]
root = args[args.index('--webroot-path') + 1]
assert name == 'bootstrap.example.test'
base = Path('/etc/letsencrypt')
archive = base / 'archive' / name
live = base / 'live' / name
archive.mkdir(parents=True, exist_ok=True)
live.mkdir(parents=True, exist_ok=True)
n = len(list(archive.glob('cert*.pem'))) + 1
key = archive / f'privkey{n}.pem'
cert = archive / f'cert{n}.pem'
csr = Path('/tmp/bootstrap.csr')
subprocess.run(['openssl', 'req', '-new', '-newkey', 'rsa:2048', '-nodes', '-keyout', str(key), '-out', str(csr), '-subj', f'/CN={name}'], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
Path('/tmp/bootstrap.ext').write_text(f'subjectAltName=DNS:{name}\nextendedKeyUsage=serverAuth\n')
subprocess.run(['openssl', 'x509', '-req', '-in', str(csr), '-CA', '/tmp/bootstrap-ca.crt', '-CAkey', '/tmp/bootstrap-ca.key', '-CAcreateserial', '-days', '90', '-extfile', '/tmp/bootstrap.ext', '-out', str(cert)], check=True, stderr=subprocess.DEVNULL)
(archive / f'chain{n}.pem').write_bytes(Path('/tmp/bootstrap-ca.crt').read_bytes())
(archive / f'fullchain{n}.pem').write_bytes(cert.read_bytes() + Path('/tmp/bootstrap-ca.crt').read_bytes())
for part in ('cert', 'chain', 'fullchain', 'privkey'):
    f = archive / f'{part}{n}.pem'
    os.chmod(f, 0o600)
    link = live / f'{part}.pem'
    link.unlink(missing_ok=True)
    link.symlink_to(f)
renewal = base / 'renewal'
renewal.mkdir(exist_ok=True)
(renewal / f'{name}.conf').write_text(f'[renewalparams]\nauthenticator = webroot\nwebroot_path = {root},\n[[webroot_map]]\n{name} = {root}\n')
with open('/tmp/certbot-calls', 'a') as f:
    f.write(' '.join(args) + '\n')
